# 运行数据
/data/
/backups/
/.env
*.db
*.db-shm
*.db-wal
/config.yaml

# 构建产物
/bin/
/dist/
# 必须带开头的斜杠。不带斜杠的模式在 git 里是"任意层级都匹配"，
# 写成 leyun 会连 cmd/leyun/ 这个目录一起忽略掉，
# 结果就是入口文件 main.go 根本进不了仓库——别人 clone 下来编译不了。
/leyun
/leyun.exe

# 前端构建产物（由 make web / Docker 构建阶段生成）
/web/dist/
# pdf.js 的字符映射表与标准字体，由 prebuild 脚本从 node_modules 复制
/web/public/pdfjs/
/web/node_modules/
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# 依赖与缓存
node_modules/
.npm/
*.log

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
